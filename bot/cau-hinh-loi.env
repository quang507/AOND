# cau-hinh-loi.env — MỘT nguồn model + công tắc của lõi production (SRS-5.1zzzzzzz401; trước nằm ở các dòng biến của
# bot/bridge-zca/cai-vps.sh, nay lưu trữ ở bot/bridge-zca/archive/ vì đã bỏ VPS).
#
# Ai đọc: test (`tests/conftest.py` qua `tests/cau_hinh_vps.py`) và bộ chấm (`scripts/cham-kich-ban.py`).
# Lõi trên máy 146 KHÔNG tự đọc tệp này: đổi dòng nào thì sửa đúng dòng đó trong C:\aond\aond_core\.env rồi khởi động lại lõi.
# Định dạng: KHOA=giatri, mỗi dòng một biến, không nháy. Công tắc: "bat" = mọi khách, "thu" = chỉ ID thử, khác = tắt.
# KHÔNG ghi khoá / mật khẩu vào đây (repo công khai).

# Model viết lời khách thật — SRS-5.1zzzzzzz235 / 308 (chủ dự án 30/10: "chuyển sang sonnet 5.5 luôn").
AIOI_CHAT_MODEL=claude-sonnet-5-5
# Model của ID thử (`ban-thu-*`); "gemini" = gọi thẳng Gemini, "tat" = như khách thật — SRS-5.1zzzzzzz239 / 243.
AIOI_CHAT_MODEL_THU=claude-sonnet-5-5
# Model bóc tách, đồng bộ cùng model chat — SRS-5.1zzzzzzz316 / 392 (chủ dự án 06/11: "chạy sonnet").
AIOI_EXTRACT_MODEL=claude-sonnet-5-5
# "bat" = ép công cụ hai ô gui_khach; "tat" = lời trả khách là chữ thường — SRS-5.1zzzzzzz246. Code đọc != "tat": trống = BẬT.
AIOI_CONG_CU_GUI_KHACH=tat
# Tin phụ "$$$$$ Đã trích xuất" sau mỗi lượt, MỌI cuộc chat (giai đoạn test; chạy thật đổi "tat") — SRS-5.1zzzzzzz252.
AIOI_DONG_TRICH_XUAT=bat
# Model viết lời cho lượt dễ của người bán; "tat" = mọi lượt dùng model chat — SRS-5.1zzzzzzz311.
AIOI_MODEL_LUOT_DE=tat
# "bat" = lượt hỏi ô người bán dùng LEAN_SYSTEM_PROMPT (<1.500 tokens); "tat" = phiếu lượt đầy đủ — SRS-5.1zzzzzzz408 (chủ dự án 11/11).
AIOI_PROMPT_GON=bat
# Gemini dự phòng khi Claude hỏng, theo thứ tự thử — SRS-5.1zzzzzzz299.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite
