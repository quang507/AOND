# systemd unit cho bridge Zalo SỐ TƯ VẤN người mua (SRS-5.1zzzzzzz210, chủ dự án 26/10/2026: "1 số … kí gửi, 1 số … tư vấn người mua",
# "đặt trên VPS"). Cùng code + .env (BRIDGE_SECRET) với nhadat-bridge.service; khác ở SO_NHAN=tu_van → file phiên zalo-session-tu-van.json,
# QR cổng 8788, /send cổng 5006, dòng bridge_dang_nhap id = 2 (thẻ "Zalo tư vấn" trên /admin).
# LẦN ĐẦU chưa có zalo-session-tu-van.json: bridge chờ quét QR — mã hiện ở /admin, quét bằng acc Zalo của SỐ TƯ VẤN (đừng quét bằng số ký gửi).
# Xem:  journalctl -u nhadat-bridge-tu-van -f
[Unit]
Description=nhadat.cc — bridge Zalo số tư vấn người mua (zca-js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nhadat
WorkingDirectory=/opt/nhadat/bot/bridge-zca
ExecStart=/usr/bin/node index.mjs
Restart=always
RestartSec=10
StartLimitIntervalSec=0
Environment=NODE_ENV=production
Environment=SO_NHAN=tu_van
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nhadat-bridge-tu-van

[Install]
WantedBy=multi-user.target
