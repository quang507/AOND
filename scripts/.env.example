# Chép thành `.env` (cùng thư mục) rồi điền. `.env` đã trong .gitignore.
#
# SUPABASE_SERVICE_ROLE_KEY — Dashboard → Project Settings → API keys →
# service_role. Khoá này BỎ QUA MỌI RLS: đọc/ghi được mọi bảng, mọi dòng.
# Dán TRẦN, không ngoặc nhọn, không nháy.
SUPABASE_SERVICE_ROLE_KEY=
#
# ANTHROPIC_API_KEY — tuỳ chọn. `bun run chat` (chat thử trên máy) và bộ đo giọng dùng
# để gọi model thật; để trống thì chat thử chạy model giả (chỉ thấy phần luật).
ANTHROPIC_API_KEY=
