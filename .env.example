# Chép thành .env rồi điền. Chạy thật: .env lõi ở C:\aond\aond_core\.env trên máy 146 (giá trị đang dùng: bot/cau-hinh-loi.env).

# Anthropic (Claude) — fast chat + vision/OCR
ANTHROPIC_API_KEY=

# "claude" (chạy thật) hoặc "claude_cli" (chỉ để test trên máy mình — gọi `claude -p`, không cần khoá API)
AIOI_LLM_PROVIDER=claude

# Model overrides (optional)
AIOI_CHAT_MODEL=claude-sonnet-5-5
AIOI_VISION_MODEL=claude-opus-4-8

# Supabase — ảnh / tài liệu (Storage), hội thoại, tin, kiến thức dự án. Không có khoá thì chạy thử: tệp ghi ra thư mục kho_tep_thu/
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — nhúng câu tìm phường / quận / đường theo nghĩa (src/aioi/dia_danh.py). Nhiều khoá cách nhau dấu phẩy, hoặc GEMINI_API_KEYS (tuỳ chọn)
GEMINI_API_KEY=
# Công tắc chỉ-Gemini (SRS-5.1zzzzzzz512): tới hết ngày TRƯỚC mốc (giờ VN, YYYY-MM-DD) mọi lượt bỏ qua Claude, đi thẳng Gemini kể cả
# vòng công cụ; tới mốc tự về Claude. Để trống = Claude chính, Gemini chỉ dự phòng.
AIOI_CHI_GEMINI_DEN=

# Google Drive API — đọc THƯ MỤC Drive khách gửi (src/aioi/drive.py; không có thì đọc Vault GOOGLE_DRIVE_API_KEY) (tuỳ chọn)
GOOGLE_API_KEY=

# Groq Whisper — chép tin nhắn thoại thành chữ (tuỳ chọn)
GROQ_API_KEY=

# Max photos KEPT per listing (storage cost control; the bot still reads all). Default 20.
AIOI_MAX_PHOTOS_PER_LISTING=20

# Khoá chặng bridge ↔ lõi (SRS-5.1zzzzzzz400): lõi từ chối mọi đường trừ /health nếu thiếu header x-noi-bo-key khớp.
# Cùng giá trị với AIOI_NOI_BO_KEY trong bot/bridge-zca/.env. Tạo: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIOI_NOI_BO_KEY=
