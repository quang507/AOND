# Copy to .env and fill in. The CLI runs in offline mock mode if no key is set.

# Anthropic (Claude) — fast chat + vision/OCR
ANTHROPIC_API_KEY=

# LLM provider: "claude" (default) or "mock" (offline, no key needed)
AIOI_LLM_PROVIDER=claude

# Model overrides (optional)
AIOI_CHAT_MODEL=claude-haiku-4-5
AIOI_VISION_MODEL=claude-opus-4-8

# Supabase — ảnh / tài liệu (Storage), hội thoại, tin, kiến thức dự án. Không có khoá thì chạy thử: tệp ghi ra thư mục kho_tep_thu/
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — nhúng câu tìm phường / quận / đường theo nghĩa (src/aioi/dia_danh.py). Nhiều khoá cách nhau dấu phẩy, hoặc GEMINI_API_KEYS (tuỳ chọn)
GEMINI_API_KEY=

# Google Drive API — đọc THƯ MỤC Drive khách gửi (src/aioi/drive.py; không có thì đọc Vault GOOGLE_DRIVE_API_KEY) (tuỳ chọn)
GOOGLE_API_KEY=

# Groq Whisper — chép tin nhắn thoại thành chữ (tuỳ chọn)
GROQ_API_KEY=

# Max photos KEPT per listing (storage cost control; the bot still reads all). Default 20.
AIOI_MAX_PHOTOS_PER_LISTING=20
